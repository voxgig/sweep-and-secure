#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""A stand-in for dotenvx used by the test-suite (no real cryptography!).

It mimics the behaviour of dotenvx 2.38 that sweep_and_secure.py depends on, as
measured against the real tool:

    dotenvx --version
    dotenvx encrypt -f FILE [-f FILE ...] [-k KEY ...] [-fk KEYSFILE] [--stdout]
        Every line defining KEY becomes KEY=encrypted:<base64 of the parsed value>,
        keeping "export", an inline comment, the quote style and CRLF line ends.
        A DOTENV_PUBLIC_KEY<SUFFIX> header with a "# -fk <path>" hint is added and
        DOTENV_PRIVATE_KEY<SUFFIX> is written to ./.env.keys (the cwd, like dotenvx
        2.x) unless -fk names another file; a file that already carries a public
        key is encrypted with it and no key is written. SUFFIX comes from the file
        name: .env -> none, .env.production -> _PRODUCTION, anything else -> _
        (an empty suffix, exactly like the real tool).
        Values are parsed by dotenvx's rules: single quotes are literal; backticks
        are literal except $NAME expansion (\\$ prevents it); double quotes expand
        $NAME, \\n and \\t, honour \\$ and keep \\" and \\\\ as they are.
        --stdout prints the result and writes nothing, not even the keys file.
        Like the real tool it prints a line with a non-ASCII glyph.
    dotenvx get KEY -f FILE [-fk KEYSFILE ...] [--overload]
        Prints the value. A variable KEY in the process environment wins unless
        --overload is given. Decrypting needs the private key: in a -fk file, in
        .env.keys next to FILE, or in the environment; without it the ciphertext is
        printed with exit status 0. A missing KEY exits 1.

    dotenvx native up|down -f FILE [-fk KEYSFILE]        (dotenvx 2.3 and later)
        up moves the private key of FILE from the keys file into the "OS secret store",
        a JSON file named by FAKE_DOTENVX_STORE (no store: exits 1 like a Linux box
        without a Secret Service), and deletes the keys file when nothing is left in it;
        down moves it back. get and keypair look in the store after the keys files.
    dotenvx keypair [KEY|provider] -f FILE [-fk KEYSFILE]
        Prints {"DOTENV_PUBLIC_KEY", "DOTENV_PRIVATE_KEY", "provider"} as JSON, or the
        one value asked for; provider is ".env.keys", the store's name or null.

Knobs: FAKE_DOTENVX_VERSION (default 2.0.0), FAKE_DOTENVX_STORE (path of the JSON file
standing in for the OS secret store), FAKE_DOTENVX_FAIL=1 (encrypt exits 1 without
touching anything), FAKE_DOTENVX_NOOP=1 (encrypt exits 0 but changes nothing),
FAKE_DOTENVX_CORRUPT=1 (encrypt stores a wrong value).
"""
from __future__ import print_function

import base64
import binascii
import io
import json
import os
import re
import sys

STORE_NAME = {"darwin": "macOS Keychain", "win32": "Windows Credential Manager"}.get(sys.platform, "Linux Secret Service")


def version():
    return tuple(int(p) for p in os.environ.get("FAKE_DOTENVX_VERSION", "2.0.0").split(".") if p.isdigit())


def store_path():
    return os.environ.get("FAKE_DOTENVX_STORE")


def store_load():
    path = store_path()
    if not path or not os.path.isfile(path):
        return {}
    with io.open(path, encoding="utf-8") as fh:
        return json.load(fh)


def store_save(data):
    with io.open(store_path(), "w", encoding="utf-8") as fh:
        json.dump(data, fh, indent=2, sort_keys=True)

ENTRY = re.compile(r"^(﻿?\s*(?:export\s+)?)([A-Za-z_][A-Za-z0-9_.\-]*)(\s*=\s*)(.*)$")
VAR = re.compile(r"\\\$|\$\{([A-Za-z_][A-Za-z0-9_]*)\}|\$([A-Za-z_][A-Za-z0-9_]*)")


def out(text):
    data = (text + u"\n").encode("utf-8")
    getattr(sys.stdout, "buffer", sys.stdout).write(data)
    sys.stdout.flush()


def err(text):
    """dotenvx (Node) writes UTF-8 to a piped stderr whatever the console code page; so does the
    stand-in, or a Windows Python would turn its glyphs into backslash escapes."""
    sys.stderr.flush()
    data = (text + u"\n").encode("utf-8")
    getattr(sys.stderr, "buffer", sys.stderr).write(data)
    sys.stderr.flush()


def closing_quote(body, quote):
    i = 0
    while i < len(body):
        if body[i] == "\\":
            i += 2
            continue
        if body[i] == quote:
            return i
        i += 1
    return -1


def expand(text):
    def repl(match):
        if match.group(0) == "\\$":
            return "$"
        return os.environ.get(match.group(1) or match.group(2), "")
    return VAR.sub(repl, text)


def parse_value(raw, quote):
    """What dotenvx makes of the text between the quotes (or the bare text)."""
    if quote == "'":
        return raw
    if quote == "`":
        return expand(raw)
    if quote == '"':
        raw = raw.replace("\\n", "\n").replace("\\t", "\t").replace("\\r", "\r")
        return expand(raw)
    return expand(raw)


def entries(lines):
    """Yield (first_line, last_line, prefix, key, sep, quote, raw_value, trailer)."""
    i = 0
    while i < len(lines):
        match = ENTRY.match(lines[i])
        if not match:
            i += 1
            continue
        prefix, key, sep, rest = match.groups()
        start = i
        rest = rest.rstrip("\r")
        if rest[:1] in ("'", '"', "`"):
            quote, body = rest[0], rest[1:]
            end = closing_quote(body, quote)
            while end < 0 and i + 1 < len(lines):
                i += 1
                body += "\n" + lines[i].rstrip("\r")
                end = closing_quote(body, quote)
            if end >= 0:
                raw, trailer = body[:end], body[end + 1:]
            else:
                raw, trailer = body, ""
        else:
            quote = ""
            if "#" in rest:
                raw, trailer = rest.split("#", 1)
                trailer = "#" + trailer
                raw = raw.rstrip()
            else:
                raw, trailer = rest.strip(), ""
        yield start, i, prefix, key, sep, quote, raw, trailer
        i += 1


def options(argv, flags):
    values, i = [], 0
    while i < len(argv):
        if argv[i] in flags and i + 1 < len(argv):
            values.append(argv[i + 1])
            i += 2
        else:
            i += 1
    return values


def suffix_for(path):
    name = os.path.basename(path)
    if name == ".env":
        return ""
    if name.startswith(".env."):
        return "_" + name[len(".env."):].upper().replace(".", "_")
    if name.endswith(".env"):
        return "_" + name[:-len(".env")].upper() + "DEVELOPMENT"
    return "_"


def header(text):
    """(suffix, key id) from the DOTENV_PUBLIC_KEY line, or (None, None)."""
    match = re.search(r"^\s*DOTENV_PUBLIC_KEY(\w*)\s*=\s*\"?([0-9A-Za-z]+)", text, re.M)
    if not match:
        return None, None
    value = match.group(2)
    return match.group(1), value[len("02fake"):] if value.startswith("02fake") else value


def private_key(path, suffix, keys_files, key_id=None, where=None):
    """The private key for path, looked for as dotenvx does: the environment, then the keys files
    (-fk ones, then the one next to the file), then the store. dotenvx 2.x matches a key to the
    file's public key whatever the key is named; 1.x goes by the name derived from the file's name
    (DOTENV_PRIVATE_KEY for .env), environment first. where (a list) receives the provider name."""
    wanted = "DOTENV_PRIVATE_KEY" + suffix
    candidates = list(keys_files) + [os.path.join(os.path.dirname(os.path.abspath(path)), ".env.keys")]
    if key_id and version() >= (2, 0, 0):
        for name in sorted(n for n in os.environ if n.startswith("DOTENV_PRIVATE_KEY")):
            if os.environ[name] == "priv" + key_id:
                if where is not None:
                    where.append("environment")
                return os.environ[name]
        for keys_file in candidates:
            if not os.path.isfile(keys_file):
                continue
            with io.open(keys_file, encoding="utf-8") as fh:
                for line in fh:
                    match = re.match(r"^\s*DOTENV_PRIVATE_KEY\w*\s*=\s*\"?(priv%s)\"?\s*$" % re.escape(key_id), line)
                    if match:
                        if where is not None:
                            where.append(".env.keys")
                        return match.group(1)
        if store_path() and os.environ.get("DOTENVX_NO_NATIVE", "").lower() != "true":
            found = store_load().get("02fake" + key_id)
            if found:
                if where is not None:
                    where.append(STORE_NAME)
                return found
        return None
    if os.environ.get(wanted):
        if where is not None:
            where.append("environment")
        return os.environ[wanted]
    for keys_file in candidates:
        if not os.path.isfile(keys_file):
            continue
        with io.open(keys_file, encoding="utf-8") as fh:
            for line in fh:
                match = re.match(r"^\s*%s\s*=\s*\"?(\S+?)\"?\s*$" % re.escape(wanted), line)
                if match:
                    if where is not None:
                        where.append(".env.keys")
                    return match.group(1)
    return None


def keys_file_arg(argv, path):
    files = options(argv, ("-fk", "--env-keys-file"))
    return os.path.abspath(files[0]) if files else os.path.join(os.path.dirname(os.path.abspath(path)), ".env.keys")


def native(argv):
    """dotenvx native up|down: the private key moves between the keys file and the store."""
    if version() < (2, 3):
        sys.stderr.write("fake dotenvx: unsupported arguments %r\n" % (["native"] + argv,))
        return 2
    action = argv[0] if argv else ""
    path = (options(argv, ("-f", "--file", "--env-file")) or [".env"])[0]
    keys_file = keys_file_arg(argv, path)
    with io.open(path, "rb") as fh:
        suffix, key_id = header(fh.read().decode("utf-8"))
    if suffix is None:
        err("☠ [MISSING_PUBLIC_KEY] no DOTENV_PUBLIC_KEY in %s" % path)
        return 1
    name = "DOTENV_PRIVATE_KEY" + suffix
    pub = "02fake" + key_id
    if action == "up":
        if not store_path():
            err("☠ failed to save private key to %s" % STORE_NAME)
            return 1
        private = private_key(path, suffix, [keys_file])
        if not private:
            err("☠ [MISSING_PRIVATE_KEY] %s not found" % name)
            return 1
        store = store_load()
        store[pub] = private
        store_save(store)
        if os.path.isfile(keys_file):   # like removeEnvKey: drop the line, delete the file when nothing is left
            with io.open(keys_file, encoding="utf-8") as fh:
                lines = [l for l in fh.read().splitlines() if not re.match(r"^\s*%s\s*=" % re.escape(name), l)]
            if any(re.match(r"^\s*[A-Za-z_][A-Za-z0-9_]*\s*=", l) for l in lines):
                with io.open(keys_file, "w", encoding="utf-8") as fh:
                    fh.write("\n".join(lines) + "\n")
            else:
                os.remove(keys_file)
        out(u"⌥ stored (%s)" % pub[:10])
        return 0
    if action == "down":
        store = store_load()
        private = store.get(pub)
        if not private:
            err("☠ [NOT_FOUND] private key not found in %s" % STORE_NAME)
            return 1
        existing = ""
        if os.path.isfile(keys_file):
            with io.open(keys_file, encoding="utf-8") as fh:
                existing = fh.read()
        if "%s=" % name not in existing:
            existing += ("" if not existing or existing.endswith("\n") else "\n") + "%s=%s\n" % (name, private)
            with io.open(keys_file, "w", encoding="utf-8") as fh:
                fh.write(existing)
        del store[pub]
        store_save(store)
        out(u"⌥ moved to %s" % os.path.basename(keys_file))
        return 0
    sys.stderr.write("fake dotenvx: unsupported native action %r\n" % (action,))
    return 2


def keypair(argv):
    """dotenvx keypair [KEY] -f FILE: the key pair of FILE and where the private key was found."""
    positional = [a for i, a in enumerate(argv) if not a.startswith("-") and (i == 0 or not argv[i - 1] in ("-f", "--file", "--env-file", "-fk", "--env-keys-file", "--format"))]
    key = positional[0] if positional else None
    path = (options(argv, ("-f", "--file", "--env-file")) or [".env"])[0]
    with io.open(path, "rb") as fh:
        data = fh.read().decode("utf-8")
    suffix, key_id = header(data)
    if suffix is None:
        suffix, key_id = suffix_for(path), None
    where = []
    private = private_key(path, suffix, options(argv, ("-fk", "--env-keys-file")), key_id, where) if key_id else None
    result = {"DOTENV_PUBLIC_KEY" + suffix: ("02fake" + key_id) if key_id else None,
              "DOTENV_PRIVATE_KEY" + suffix: private, "provider": where[0] if where else None}
    if key:
        value = result.get(key)
        if value is None:
            return 1
        out(value)
        return 0
    out(json.dumps(result))
    return 0


def encrypt(argv):
    files = options(argv, ("-f", "--file", "--env-file")) or [".env"]
    keys = options(argv, ("-k", "--key"))
    keys_files = options(argv, ("-fk", "--env-keys-file"))
    to_stdout = "--stdout" in argv
    if os.environ.get("FAKE_DOTENVX_FAIL"):
        sys.stderr.write("fake dotenvx: simulated failure\n")
        return 1
    if os.environ.get("FAKE_DOTENVX_NOOP"):
        return 0
    for path in files:
        # without -fk, dotenvx 1.x writes .env.keys next to the file it encrypts and 2.x into the
        # current directory (measured against 1.0.0, 1.4.0, 1.38.0 and 2.38.2)
        if keys_files:
            keys_file = os.path.abspath(keys_files[0])
        elif version() >= (2, 0, 0):
            keys_file = os.path.join(os.getcwd(), ".env.keys")
        else:
            keys_file = os.path.join(os.path.dirname(os.path.abspath(path)), ".env.keys")
        with io.open(path, "rb") as fh:
            data = fh.read().decode("utf-8")
        newline = "\r\n" if "\r\n" in data else "\n"
        lines = data.replace("\r\n", "\n").split("\n")
        suffix, key_id = header(data)
        new_key = suffix is None
        if new_key:
            suffix = suffix_for(path)
            key_id = binascii.hexlify(os.urandom(8)).decode("ascii")
        found = dict((start, item) for item in entries(lines) for start in [item[0]])
        result, i = [], 0
        while i < len(lines):
            if i in found:
                start, end, prefix, key, sep, quote, raw, trailer = found[i]
                wanted = (not keys or key in keys) and not key.startswith("DOTENV_")
                if wanted and not raw.startswith("encrypted:"):
                    value = parse_value(raw, quote)
                    if os.environ.get("FAKE_DOTENVX_CORRUPT"):
                        value = value[:-1]
                    # the "ciphertext" names the key pair, so that only the matching private key opens it
                    token = "encrypted:" + base64.b64encode((key_id + "|" + value).encode("utf-8")).decode("ascii")
                    result.append(prefix + key + sep + quote + token + quote + trailer)
                    i = end + 1
                    continue
            result.append(lines[i])
            i += 1
        text = "\n".join(result)
        if new_key:
            hint = os.path.relpath(keys_file, os.path.dirname(os.path.abspath(path))).replace(os.sep, "/")
            text = 'DOTENV_PUBLIC_KEY%s="02fake%s" # -fk %s\n%s' % (suffix, key_id, hint, text)
        text = text.replace("\n", newline)
        if to_stdout:
            out(text)
            continue
        with io.open(path, "w", encoding="utf-8", newline="") as fh:
            fh.write(text)
        if new_key and os.environ.get("FAKE_DOTENVX_NO_KEYS_FILE"):
            out(u"◈ encrypted %s (fake); the private key is kept elsewhere ⛉" % path)
            continue
        if new_key:
            existing = ""
            if os.path.isfile(keys_file):
                with io.open(keys_file, encoding="utf-8") as fh:
                    existing = fh.read()
            if "DOTENV_PRIVATE_KEY%s=" % suffix not in existing:
                if existing and not existing.endswith("\n"):
                    existing += "\n"
                existing += "DOTENV_PRIVATE_KEY%s=priv%s\n" % (suffix, key_id)
                with io.open(keys_file, "w", encoding="utf-8") as fh:
                    fh.write(existing)
                try:
                    os.chmod(keys_file, 0o600)
                except OSError:
                    pass
        out(u"◈ encrypted %s (fake) via %s ⛉" % (path, os.path.basename(keys_file)))
    return 0


def get(argv):
    key = argv[0]
    path = (options(argv, ("-f", "--file", "--env-file")) or [".env"])[0]
    keys_files = options(argv, ("-fk", "--env-keys-file"))
    overload = "--overload" in argv or "-o" in argv
    if key in os.environ and not overload:
        out(os.environ[key])
        return 0
    with io.open(path, "rb") as fh:
        data = fh.read().decode("utf-8")
    lines = data.replace("\r\n", "\n").split("\n")
    suffix, _key_id = header(data)
    if suffix is None:
        suffix = suffix_for(path)
    private = private_key(path, suffix, keys_files, _key_id)
    value = None
    for _, _, _, name, _, quote, raw, _ in entries(lines):
        if name == key:
            if raw.startswith("encrypted:"):
                value = raw   # without the matching key dotenvx prints the ciphertext and exits 0
                try:
                    plain = base64.b64decode(raw[len("encrypted:"):].encode("ascii")).decode("utf-8")
                    key_id, plain = plain.split("|", 1)
                except (ValueError, TypeError, binascii.Error):
                    continue
                if private == "priv" + key_id:
                    value = plain
            else:
                value = parse_value(raw, quote)
    if value is None:
        sys.stderr.write("fake dotenvx: [MISSING_KEY] %s not found in %s\n" % (key, path))
        return 1
    out(value)
    return 0


def main(argv):
    if "--version" in argv:
        print(os.environ.get("FAKE_DOTENVX_VERSION", "2.0.0"))
        return 0
    if argv and argv[0] == "encrypt":
        return encrypt(argv[1:])
    if argv and argv[0] == "get":
        return get(argv[1:])
    if argv and argv[0] == "native":
        return native(argv[1:])
    if argv and argv[0] == "keypair":
        return keypair(argv[1:])
    sys.stderr.write("fake dotenvx: unsupported arguments %r\n" % (argv,))
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
